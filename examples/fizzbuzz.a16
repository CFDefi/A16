fn main():
    println("FizzBuzz 1-20:")
    for i in range(20):
        let num = i + 1
        let div3 = num % 3 == 0
        let div5 = num % 5 == 0
        if div3:
            if div5:
                println("FizzBuzz")
            else:
                println("Fizz")
        else:
            if div5:
                println("Buzz")
            else:
                println(num)
    return 0
