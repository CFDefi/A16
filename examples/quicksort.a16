fn main():
    let mut nums = [64, 34, 25, 12, 22, 11, 90]
    println("Original list:")
    println(nums)
    
    let n = len(nums)
    for i in range(n):
        for j in range(n - 1):
            if nums[j] > nums[j + 1]:
                let temp = nums[j]
                nums[j] = nums[j + 1]
                nums[j + 1] = temp
    
    println("Sorted:")
    println(nums)
    return 0
